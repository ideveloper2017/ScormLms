# Spring profile
SPRING_PROFILES_ACTIVE=postgresql-prod

# PostgreSQL (productionda barchasini almashtirish majburiy)
DB_URL=jdbc:postgresql://localhost:5432/scorm_lms
DB_USERNAME=scorm_lms
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# Authentication: HS512 uchun tasodifiy, kamida 64 baytlik secret ishlating.
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_BYTES_NEVER_COMMIT_REAL_VALUE
APP_SEED_ADMIN_PASSWORD=

# Public origins (vergul bilan ajratiladi; wildcard ishlatmang)
CORS_ALLOWED_ORIGINS=https://lms.example.uz,https://scorm.example.uz

# Persistent storage
FILE_UPLOAD_DIR=/var/lib/scorm-lms/uploads
SCORM_STORAGE_DIR=/var/lib/scorm-lms/scorm
SCORM_MAX_PACKAGE_BYTES=209715200
ASSIGNMENT_STORAGE_DIR=/var/lib/scorm-lms/assignments
ASSIGNMENT_MAX_FILE_BYTES=10485760
SCORM_SECURE_COOKIE=true

# HEMIS integration
HEMIS_HOST=https://student.example.uz
HEMIS_ADMIN_LOGIN=
HEMIS_ADMIN_PASSWORD=

# Productionda odatda o'chiriladi
SWAGGER_ENABLED=false
