# Spring profile
SPRING_PROFILES_ACTIVE=postgresql-prod
# HEMIS OAuth2 yoqilganda: SPRING_PROFILES_ACTIVE=postgresql-prod,hemis-oauth

# PostgreSQL (productionda barchasini almashtirish majburiy)
DB_URL=jdbc:postgresql://localhost:5432/scorm_lms
DB_USERNAME=scorm_lms
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# Backup/restore (maxfiy DB paroli skript argumentida emas, env orqali beriladi)
POSTGRES_BIN=/usr/lib/postgresql/16/bin
BACKUP_OUTPUT_DIR=/var/backups/scorm-lms
BACKUP_RPO_HOURS=24

# Authentication: HS512 uchun tasodifiy, kamida 64 baytlik secret ishlating.
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_BYTES_NEVER_COMMIT_REAL_VALUE
SURVEY_ANONYMIZATION_SECRET=CHANGE_ME_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_64_BYTES
APP_SEED_ADMIN_PASSWORD=
APP_SEED_TEACHER_PASSWORD=
APP_SEED_STUDENT_PASSWORD=

# Faqat reverse proxy ichki IP manzillari. Bo'sh bo'lsa X-Forwarded-For ishonchsiz deb olinadi.
TRUSTED_PROXY_IPS=127.0.0.1,::1
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_PER_IP=30
AUTH_EXTERNAL_PER_IP=20
AUTH_TOKEN_PER_IP=60
AUTH_RATE_MAX_BUCKETS=10000

# Public origins (vergul bilan ajratiladi; wildcard ishlatmang)
CORS_ALLOWED_ORIGINS=https://lms.example.uz,https://scorm.example.uz

# Persistent storage
FILE_UPLOAD_DIR=/var/lib/scorm-lms/uploads
SCORM_STORAGE_DIR=/var/lib/scorm-lms/scorm
SCORM_MAX_PACKAGE_BYTES=209715200
ASSIGNMENT_STORAGE_DIR=/var/lib/scorm-lms/assignments
ASSIGNMENT_MAX_FILE_BYTES=10485760
COURSE_CONTENT_STORAGE_DIR=/var/lib/scorm-lms/course-content
COURSE_CONTENT_MAX_FILE_BYTES=209715200
UAT_PRIVATE_STORAGE_DIR=/var/lib/scorm-lms/uat-559
SCORM_SECURE_COOKIE=true

# Videokonferensiya provider adapteri (bo'sh bo'lsa provisioning fail-closed)
VIDEO_CONFERENCE_PROVIDER_CODE=UNCONFIGURED
VIDEO_CONFERENCE_PROVISION_URL=
VIDEO_CONFERENCE_TOKEN=

# HEMIS integration
HEMIS_HOST=https://student.example.uz
HEMIS_ADMIN_LOGIN=
HEMIS_ADMIN_PASSWORD=
# OAuth2 login (SPRING_PROFILES_ACTIVE profiliga `hemis-oauth`ni ham qo'shing)
HEMIS_OAUTH_CLIENT_ID=
HEMIS_OAUTH_CLIENT_SECRET=
HEMIS_OAUTH_CLIENT_AUTH_METHOD=client_secret_post
HEMIS_OAUTH_AUTHORIZATION_URI=
HEMIS_OAUTH_TOKEN_URI=
HEMIS_OAUTH_USER_INFO_URI=
HEMIS_OAUTH_REDIRECT_URI=https://api.lms.example.uz/login/oauth2/code/hemis
HEMIS_OAUTH_SCOPES=profile
HEMIS_OAUTH_ID_ATTRIBUTE=id
HEMIS_OAUTH_USERNAME_ATTRIBUTE=login
HEMIS_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/hemis/callback
HEMIS_OAUTH_LOGIN_CODE_TTL_SECONDS=60
# Mappinglar tekshirilgachgina productionda true qiling
HEMIS_SYNC_ENABLED=false
HEMIS_SYNC_ASYNC_ENABLED=true
HEMIS_SYNC_PAGE_SIZE=100
HEMIS_SYNC_CRON=0 0 */6 * * *

# Productionda odatda o'chiriladi
SWAGGER_ENABLED=false
