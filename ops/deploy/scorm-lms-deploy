#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_FILE="/etc/scorm-lms/deploy.conf"

log() {
  printf '[scorm-lms-deploy] %s\n' "$*"
}

fail() {
  printf '[scorm-lms-deploy] ERROR: %s\n' "$*" >&2
  return 1
}

[[ $EUID -eq 0 ]] || fail "This command must run as root"
[[ $# -eq 1 ]] || fail "Usage: scorm-lms-deploy <40-char-sha>-<run-id>-<attempt>"
[[ -r "$CONFIG_FILE" ]] || fail "$CONFIG_FILE is missing or unreadable"

# shellcheck source=/dev/null
source "$CONFIG_FILE"

: "${DEPLOY_INCOMING_DIR:?DEPLOY_INCOMING_DIR is required}"
: "${FRONTEND_BASE_DIR:?FRONTEND_BASE_DIR is required}"
: "${TOMCAT_WEBAPPS_DIR:?TOMCAT_WEBAPPS_DIR is required}"
: "${TOMCAT_SERVICE:?TOMCAT_SERVICE is required}"
: "${HEALTHCHECK_URL:?HEALTHCHECK_URL is required}"
: "${DEPLOY_BACKUP_DIR:?DEPLOY_BACKUP_DIR is required}"

APP_ENV_FILE="${APP_ENV_FILE:-/etc/scorm-lms/scorm-lms.env}"
EXPECTED_DATABASE_NAME="${EXPECTED_DATABASE_NAME:-scorm_lms}"
AUTO_CREATE_DATABASE="${AUTO_CREATE_DATABASE:-false}"

read_app_env() {
  local key="$1"
  local line value
  line="$(grep -E "^${key}=" "$APP_ENV_FILE" | tail -n 1 || true)"
  [[ -n "$line" ]] || return 1
  value="${line#*=}"
  value="${value%$'\r'}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

ensure_application_database() {
  [[ "$AUTO_CREATE_DATABASE" == "true" || "$AUTO_CREATE_DATABASE" == "false" ]] || \
    fail "AUTO_CREATE_DATABASE must be true or false"
  [[ -r "$APP_ENV_FILE" ]] || fail "$APP_ENV_FILE is missing or unreadable"
  [[ "$EXPECTED_DATABASE_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || \
    fail "Unsafe EXPECTED_DATABASE_NAME"

  local active_profiles db_url db_user db_password db_schema host port database
  active_profiles="$(read_app_env SPRING_PROFILES_ACTIVE)" || \
    fail "SPRING_PROFILES_ACTIVE is missing in $APP_ENV_FILE"
  case ",$active_profiles," in
    *,postgresql-prod,*|*,postgres,*) ;;  # postgres — postgresql-prod taxallusi
    *) fail "SPRING_PROFILES_ACTIVE must include postgresql-prod" ;;
  esac

  db_url="$(read_app_env DB_URL)" || fail "DB_URL is missing in $APP_ENV_FILE"
  db_user="$(read_app_env DB_USERNAME)" || fail "DB_USERNAME is missing in $APP_ENV_FILE"
  db_password="$(read_app_env DB_PASSWORD)" || fail "DB_PASSWORD is missing in $APP_ENV_FILE"
  db_schema="$(read_app_env DB_SCHEMA || printf 'public')"
  [[ "$db_user" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "Unsafe DB_USERNAME"
  [[ -n "$db_password" ]] || fail "DB_PASSWORD must not be empty"
  [[ "$db_schema" =~ ^[a-z_][a-z0-9_]*$ ]] || \
    fail "DB_SCHEMA must be an unquoted lowercase PostgreSQL identifier"

  if [[ "$db_url" =~ ^jdbc:postgresql://([^/:?]+)(:([0-9]+))?/([A-Za-z_][A-Za-z0-9_]*)(\?.*)?$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[3]:-5432}"
    database="${BASH_REMATCH[4]}"
  else
    fail "DB_URL must use jdbc:postgresql://host:port/database format"
  fi

  [[ "$database" == "$EXPECTED_DATABASE_NAME" ]] || \
    fail "Refusing database '$database'; expected '$EXPECTED_DATABASE_NAME'. Fix DB_URL in $APP_ENV_FILE"

  command -v psql >/dev/null || fail "psql is required for PostgreSQL preflight"

  if [[ "$host" != "localhost" && "$host" != "127.0.0.1" ]]; then
    [[ "$AUTO_CREATE_DATABASE" == "false" ]] || \
      fail "Automatic database creation is allowed only for local PostgreSQL; provision '$database' on '$host' manually"
    log "Remote PostgreSQL detected; database creation preflight skipped"
  else
    command -v runuser >/dev/null || fail "runuser is required for PostgreSQL provisioning"
    command -v createdb >/dev/null || fail "createdb is required for PostgreSQL provisioning"

    local role_exists database_exists
    role_exists="$(runuser -u postgres -- psql --no-psqlrc --port "$port" \
      --dbname postgres --tuples-only --no-align --set=role="$db_user" \
      --command="SELECT 1 FROM pg_roles WHERE rolname = :'role'" | tr -d '[:space:]')"
    [[ "$role_exists" == "1" ]] || \
      fail "PostgreSQL role '$db_user' does not exist; create it once with: sudo -u postgres createuser --pwprompt $db_user"

    database_exists="$(runuser -u postgres -- psql --no-psqlrc --port "$port" \
      --dbname postgres --tuples-only --no-align --set=db="$database" \
      --command="SELECT 1 FROM pg_database WHERE datname = :'db'" | tr -d '[:space:]')"
    if [[ "$database_exists" != "1" ]]; then
      [[ "$AUTO_CREATE_DATABASE" == "true" ]] || \
        fail "PostgreSQL database '$database' does not exist and AUTO_CREATE_DATABASE=false"
      log "Creating PostgreSQL database '$database' owned by '$db_user'"
      runuser -u postgres -- createdb --port "$port" --owner "$db_user" "$database"
    fi
    log "PostgreSQL database '$database' is ready"
  fi

  local psql_app=(psql --no-psqlrc --no-password --host "$host" --port "$port" \
    --username "$db_user" --dbname "$database" --tuples-only --no-align \
    --set=ON_ERROR_STOP=1)
  local schema_state actual_database actual_user schema_exists can_use can_create
  schema_state="$(PGPASSWORD="$db_password" "${psql_app[@]}" --field-separator='|' --command="
    SELECT current_database(), current_user,
           to_regnamespace('$db_schema') IS NOT NULL,
           COALESCE(has_schema_privilege(current_user, to_regnamespace('$db_schema'), 'USAGE'), FALSE),
           COALESCE(has_schema_privilege(current_user, to_regnamespace('$db_schema'), 'CREATE'), FALSE);
  ")" || fail "Cannot connect to PostgreSQL as '$db_user' or run Flyway preflight"
  IFS='|' read -r actual_database actual_user schema_exists can_use can_create <<<"$schema_state"
  [[ "$actual_database" == "$database" ]] || fail "Connected to unexpected PostgreSQL database '$actual_database'"
  [[ "$actual_user" == "$db_user" ]] || fail "Connected as unexpected PostgreSQL user '$actual_user'"
  [[ "$schema_exists" == "t" ]] || fail "PostgreSQL schema '$db_schema' does not exist"
  [[ "$can_use" == "t" && "$can_create" == "t" ]] || \
    fail "PostgreSQL user '$db_user' needs USAGE and CREATE privileges on schema '$db_schema' for Flyway"

  local history_exists table_count failed_count current_version
  history_exists="$(PGPASSWORD="$db_password" "${psql_app[@]}" --command="
    SELECT to_regclass('$db_schema.flyway_schema_history') IS NOT NULL;
  " | tr -d '[:space:]')"
  table_count="$(PGPASSWORD="$db_password" "${psql_app[@]}" --command="
    SELECT count(*) FROM pg_tables
    WHERE schemaname = '$db_schema' AND tablename <> 'flyway_schema_history';
  " | tr -d '[:space:]')"

  if [[ "$history_exists" == "t" ]]; then
    failed_count="$(PGPASSWORD="$db_password" "${psql_app[@]}" --command="
      SELECT count(*) FROM $db_schema.flyway_schema_history WHERE NOT success;
    " | tr -d '[:space:]')"
    [[ "$failed_count" == "0" ]] || \
      fail "Flyway history contains $failed_count failed migration(s); inspect and repair them before deployment"
    current_version="$(PGPASSWORD="$db_password" "${psql_app[@]}" --command="
      SELECT COALESCE(version, 'baseline') FROM $db_schema.flyway_schema_history
      WHERE success ORDER BY installed_rank DESC LIMIT 1;
    " | tr -d '[:space:]')"
    log "Flyway preflight passed: schema=$db_schema, current-version=${current_version:-none}, tables=$table_count"
  elif [[ "$table_count" != "0" ]]; then
    local baseline_on_migrate baseline_version
    baseline_on_migrate="$(read_app_env FLYWAY_BASELINE_ON_MIGRATE || printf 'true')"
    baseline_version="$(read_app_env FLYWAY_BASELINE_VERSION || printf '0')"
    [[ "$baseline_on_migrate" == "true" && "$baseline_version" == "0" ]] || \
      fail "Non-empty schema has no Flyway history. Set FLYWAY_BASELINE_ON_MIGRATE=true and FLYWAY_BASELINE_VERSION=0 after verifying this is the legacy LMS schema"
    log "Legacy schema detected: $table_count table(s), no Flyway history; baseline version 0 will be used"
  else
    log "Empty schema detected; Flyway will create schema history and migrate from V1"
  fi
}

# Tomcat to'xtatilishidan oldin: bo'sh yoki namuna secret bilan ilova ishga tushmaydi
# (ProductionSecretsGuard), shuning uchun buni downtime'siz shu yerda aniqlaymiz.
ensure_required_app_secrets() {
  local key value
  # systemd EnvironmentFile CRLF'dagi \r ni qiymatga qo'shib qo'yadi: profil
  # "postgresql-prod\r" bo'lib, prod sozlamalari (app.jwt.secret ...) yuklanmaydi.
  ! grep -q $'\r' "$APP_ENV_FILE" || \
    fail "$APP_ENV_FILE has Windows (CRLF) line endings; fix with: sed -i 's/\\r\$//' $APP_ENV_FILE"
  for key in JWT_SECRET CORS_ALLOWED_ORIGINS; do
    value="$(read_app_env "$key")" || fail "$key is missing in $APP_ENV_FILE"
    [[ -n "$value" ]] || fail "$key must not be empty in $APP_ENV_FILE"
  done
  # SURVEY_ANONYMIZATION_SECRET berilmasa ilova JWT_SECRET'dan foydalanadi.
  for key in JWT_SECRET SURVEY_ANONYMIZATION_SECRET; do
    value="$(read_app_env "$key")" || continue
    [[ "${value,,}" != *change_me* && "${value,,}" != *dev-only* ]] || \
      fail "$key in $APP_ENV_FILE still contains a placeholder value"
    (( ${#value} >= 64 )) || fail "$key must be at least 64 bytes (openssl rand -base64 96)"
  done
  value="$(read_app_env DB_PASSWORD)"
  [[ "${value,,}" != *change_me* ]] || fail "DB_PASSWORD in $APP_ENV_FILE still contains a placeholder value"
  (( ${#value} >= 12 )) || fail "DB_PASSWORD must be at least 12 characters"
  [[ "$(read_app_env CORS_ALLOWED_ORIGINS)" != *'*'* ]] || \
    fail "CORS_ALLOWED_ORIGINS must list explicit origins, not a wildcard"
  [[ "$(read_app_env APP_DEMO_DATA_ENABLED || printf 'false')" != "true" ]] || \
    log "WARNING: APP_DEMO_DATA_ENABLED=true; demo users will be created in production"
}

ensure_tomcat_environment() {
  command -v systemctl >/dev/null || fail "systemctl is required to control $TOMCAT_SERVICE"

  local environment_files
  environment_files="$(systemctl show "$TOMCAT_SERVICE" --property=EnvironmentFiles --value)" || \
    fail "Cannot inspect $TOMCAT_SERVICE environment"
  [[ "$environment_files" == *"$APP_ENV_FILE"* ]] || \
    fail "$TOMCAT_SERVICE does not load $APP_ENV_FILE. Add EnvironmentFile=$APP_ENV_FILE to its systemd service override"
}

# Yuz tanish modellari (SFaceRecognizer) bo'lmasa proktoring fail-closed ishlamay qoladi — buni deploydan
# keyin emas, oldin aniqlaymiz. Skript tarmoqdan hech narsa yuklamaydi: o'rnatish
# ops/face-models/install-face-models.sh orqali alohida bajariladi.
ensure_face_models() {
  local model_dir
  model_dir="$(read_app_env FACE_MODEL_DIR)" || \
    fail "FACE_MODEL_DIR is not set in $APP_ENV_FILE. Install face models: FACE_MODEL_DIR=/var/lib/scorm-lms/face-models ops/face-models/install-face-models.sh, then add FACE_MODEL_DIR to $APP_ENV_FILE"
  local entry name sha
  for entry in \
    "face_detection_yunet_2023mar.onnx:8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4" \
    "face_recognition_sface_2021dec.onnx:0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79"; do
    name="${entry%%:*}"
    sha="${entry#*:}"
    [[ -f "$model_dir/$name" ]] || fail "Face model $model_dir/$name is missing. Run ops/face-models/install-face-models.sh"
    echo "$sha  $model_dir/$name" | sha256sum -c --status || fail "Face model $model_dir/$name has wrong SHA-256. Re-run ops/face-models/install-face-models.sh"
  done
  log "Face models verified in $model_dir"

  # bytedeco libopencv_highgui.so GTK2 ga bog'langan; bo'lmasa yuz tanish native'lari yuklanmaydi
  # ("no jniopencv_highgui in java.library.path").
  ldconfig -p | grep -q 'libgtk-x11-2.0.so.0' || \
    fail "GTK2 runtime (libgtk-x11-2.0.so.0) is missing; OpenCV face recognition cannot load. Install: apt-get install -y libgtk2.0-0t64 (older Ubuntu/Debian: libgtk2.0-0)"
}

readonly RELEASE_ID="$1"
[[ "$RELEASE_ID" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ ]] || fail "Invalid release id"

for path in "$DEPLOY_INCOMING_DIR" "$FRONTEND_BASE_DIR" "$TOMCAT_WEBAPPS_DIR" "$DEPLOY_BACKUP_DIR"; do
  [[ "$path" == /* && "$path" != "/" && "$path" != *".."* ]] || fail "Unsafe configured path: $path"
done
[[ "$TOMCAT_SERVICE" =~ ^[A-Za-z0-9@_.-]+$ ]] || fail "Invalid TOMCAT_SERVICE"
[[ "$HEALTHCHECK_URL" =~ ^https?://(127\.0\.0\.1|localhost)(:[0-9]+)?/[-A-Za-z0-9_./]+$ ]] || \
  fail "HEALTHCHECK_URL must use localhost or 127.0.0.1"

readonly INCOMING_DIR="$DEPLOY_INCOMING_DIR/$RELEASE_ID"
readonly INCOMING_WAR="$INCOMING_DIR/ROOT.war"
readonly INCOMING_FRONTEND="$INCOMING_DIR/frontend.tar.gz"
readonly RELEASES_DIR="$FRONTEND_BASE_DIR/releases"
readonly NEW_FRONTEND_RELEASE="$RELEASES_DIR/$RELEASE_ID"
readonly CURRENT_LINK="$FRONTEND_BASE_DIR/current"
readonly TOMCAT_WAR="$TOMCAT_WEBAPPS_DIR/ROOT.war"
readonly TOMCAT_EXPLODED="$TOMCAT_WEBAPPS_DIR/ROOT"
readonly BACKUP_DIR="$DEPLOY_BACKUP_DIR/$RELEASE_ID"

[[ -f "$INCOMING_WAR" ]] || fail "$INCOMING_WAR is missing"
[[ -f "$INCOMING_FRONTEND" ]] || fail "$INCOMING_FRONTEND is missing"
[[ -f "$INCOMING_DIR/checksums.sha256" ]] || fail "checksums.sha256 is missing"

cd "$INCOMING_DIR"
sha256sum -c checksums.sha256

ensure_application_database
ensure_required_app_secrets
ensure_tomcat_environment
ensure_face_models

install -d -m 755 "$RELEASES_DIR"
install -d -m 700 "$BACKUP_DIR"

previous_frontend=""
if [[ -L "$CURRENT_LINK" ]]; then
  previous_frontend="$(readlink -f "$CURRENT_LINK")"
elif [[ -e "$CURRENT_LINK" ]]; then
  fail "$CURRENT_LINK must be a symlink"
fi

had_previous_war=false
if [[ -f "$TOMCAT_WAR" ]]; then
  cp --preserve=mode,timestamps "$TOMCAT_WAR" "$BACKUP_DIR/ROOT.war"
  had_previous_war=true
fi

frontend_switched=false
backend_switched=false

rollback() {
  local original_exit=$?
  trap - ERR
  log "Deployment failed; rolling back"

  if command -v journalctl >/dev/null; then
    log "Latest $TOMCAT_SERVICE logs (Flyway/startup diagnostics):"
    journalctl --unit "$TOMCAT_SERVICE" --lines 150 --no-pager || true
  fi

  if [[ "$frontend_switched" == true ]]; then
    if [[ -n "$previous_frontend" && -d "$previous_frontend" ]]; then
      ln -sfn "$previous_frontend" "$FRONTEND_BASE_DIR/.current-rollback"
      mv -Tf "$FRONTEND_BASE_DIR/.current-rollback" "$CURRENT_LINK"
    else
      rm -f "$CURRENT_LINK"
    fi
  fi

  if [[ "$backend_switched" == true ]]; then
    systemctl stop "$TOMCAT_SERVICE" || true
    rm -f "$TOMCAT_WAR"
    rm -rf --one-file-system "$TOMCAT_EXPLODED"
    if [[ "$had_previous_war" == true ]]; then
      install -m 0644 "$BACKUP_DIR/ROOT.war" "$TOMCAT_WAR"
    fi
    systemctl start "$TOMCAT_SERVICE" || true
  fi

  exit "$original_exit"
}
trap rollback ERR

rm -rf --one-file-system "$NEW_FRONTEND_RELEASE"
install -d -m 755 "$NEW_FRONTEND_RELEASE"
tar -xzf "$INCOMING_FRONTEND" -C "$NEW_FRONTEND_RELEASE" \
  --no-same-owner --no-same-permissions
[[ -f "$NEW_FRONTEND_RELEASE/index.html" ]] || fail "Frontend artifact has no index.html"

ln -sfn "$NEW_FRONTEND_RELEASE" "$FRONTEND_BASE_DIR/.current-$RELEASE_ID"
mv -Tf "$FRONTEND_BASE_DIR/.current-$RELEASE_ID" "$CURRENT_LINK"
frontend_switched=true

log "Stopping $TOMCAT_SERVICE"
systemctl stop "$TOMCAT_SERVICE"
install -m 0644 "$INCOMING_WAR" "$TOMCAT_WAR"
rm -rf --one-file-system "$TOMCAT_EXPLODED"
backend_switched=true
systemctl start "$TOMCAT_SERVICE"

log "Waiting for readiness: $HEALTHCHECK_URL"
ready=false
for attempt in $(seq 1 60); do
  if curl --fail --silent --show-error --max-time 5 "$HEALTHCHECK_URL" >/dev/null; then
    ready=true
    break
  fi
  sleep 5
done
[[ "$ready" == true ]] || fail "Application did not become ready within 5 minutes"

trap - ERR
rm -rf --one-file-system "$INCOMING_DIR"
log "Release $RELEASE_ID deployed successfully"
