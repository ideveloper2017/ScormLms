# Backend konteyneri sozlamalari (ixtiyoriy). Kerak bo'lsa:  cp docker/backend.env.example docker/backend.env
# Faqat o'zgartiradigan qatorlarni oching (# ni olib tashlang). Bo'sh qoldirilgan qiymat yozmang.

# --- Baza (PostgreSQL hostda) ---
#DB_URL=jdbc:postgresql://localhost:5432/scorm_lms
#DB_USERNAME=scorm_lms
#DB_PASSWORD=bazadagi-haqiqiy-parol

# --- Xavfsizlik ---
# Berilmasa har qayta ishga tushganda foydalanuvchilar qayta kiradi. Yaratish: openssl rand -base64 64 | tr -d '\n'
#JWT_SECRET=
#SURVEY_ANONYMIZATION_SECRET=
# Yangi bazada superadmin/admin uchun boshlang'ich parol (12+ belgi, login nomisiz)
#APP_SEED_ADMIN_PASSWORD=

# --- Tarmoq ---
#SERVER_PORT=8080
# Frontend boshqa domenda bo'lsa (bitta domenda nginx orqali bo'lsa kerak emas)
#CORS_ALLOWED_ORIGINS=https://lms.example.uz
# Sayt HTTPS'siz (http://IP) ochilsa false qiling, aks holda SCORM sessiya cookie'si saqlanmaydi
#SCORM_SECURE_COOKIE=true

# --- Profil (HEMIS OAuth kerak bo'lsa qo'shing) ---
#SPRING_PROFILES_ACTIVE=postgresql-prod,hemis-oauth,hemis-employee-oauth
#HEMIS_HOST=
#HEMIS_API_TOKEN=

# --- JVM (standart: konteyner xotirasining 75%) ---
#JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8
