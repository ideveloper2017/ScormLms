# API manzili. Dev rejimda standart `/api/v1`: vite proxy uni VITE_PROXY_TARGET ga uzatadi (CORS kerak emas).
# Production'da nginx `/api` ni backend'ga uzatsa ham shu nisbiy qiymat yetarli.
VITE_API_BASE_URL=/api/v1
# Dev proxy qayerga uzatadi (backend). Boshqa port yoki uzoqdagi server bo'lsa o'zgartiring.
VITE_PROXY_TARGET=http://localhost:8080
# Dev server: port, tarmoqdan ochish (telefonda sinash uchun VITE_HOST=true), brauzerni avtomatik ochish
VITE_PORT=5173
VITE_HOST=false
VITE_OPEN=false
# Build: xatolarni asl kodga bog'lash uchun sourcemap (production'da odatda false)
VITE_SOURCEMAP=false
# WebSocket endpoint (productionda wss:// ishlating)
# Nisbiy `/ws` bo'lsa sahifa manzilidan ws:// yoki wss:// yasaladi; absolyut ws://host/ws ham mumkin
VITE_WS_URL=/ws
# SCORM kontenti alohida API originida ochiladi; bu paketni frontend tokenlaridan ajratadi.
VITE_SCORM_CONTENT_ORIGIN=http://localhost:8080

# CKEditor self-hosted: GPL-compatible loyiha uchun GPL, aks holda commercial kalit.
# Bo'sh bo'lsa CKEditor o'rniga oddiy matn/HTML muharriri chiqadi.
# Matematik formula ("∑ Formula", LaTeX/KaTeX) CKEditor'ning o'zida, alohida litsenziyasiz ishlaydi.
VITE_CKEDITOR_LICENSE_KEY=
# MathType/ChemType tugmalari: faqat WIRIS litsenziyasi bo'lsa true qiling.
VITE_MATHTYPE_ENABLED=
