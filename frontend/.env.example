# API server manzili
VITE_API_BASE_URL=http://localhost:8080/api/v1
# WebSocket endpoint (productionda wss:// ishlating)
VITE_WS_URL=ws://localhost:8080/ws
# SCORM kontenti alohida API originida ochiladi; bu paketni frontend tokenlaridan ajratadi.
VITE_SCORM_CONTENT_ORIGIN=http://localhost:8080

# CKEditor self-hosted: GPL-compatible loyiha uchun GPL, aks holda commercial kalit.
# Bo'sh bo'lsa CKEditor o'rniga oddiy matn/HTML muharriri chiqadi.
# Matematik formula ("∑ Formula", LaTeX/KaTeX) CKEditor'ning o'zida, alohida litsenziyasiz ishlaydi.
VITE_CKEDITOR_LICENSE_KEY=
# MathType/ChemType tugmalari: faqat WIRIS litsenziyasi bo'lsa true qiling.
VITE_MATHTYPE_ENABLED=
